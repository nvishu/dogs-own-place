# Copy this file to .env.local for local dev. On Vercel add the same names under
# Project → Settings → Environment Variables. NEVER commit real values.

# MongoDB Atlas connection string (URL-encode special chars in the password: @ → %40, $ → %24)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dogs-own-place?retryWrites=true&w=majority

# Random string, 32+ chars. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin login (no DB record). Use a long unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "false" in production once real payments (Razorpay) are integrated
ALLOW_MOCK_PAYMENTS=true

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Business details shown on the site (all optional; defaults live in src/lib/site.js) ──
NEXT_PUBLIC_PHONE=+91 98765 43210
NEXT_PUBLIC_EMAIL=hello@dogsownplace.com
# WhatsApp button appears only when set. Digits only, with country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP=

# ── Owner alerts: new sign-ups, new bookings, cancellations (all optional, use one or both) ──
# 1) Email via resend.com (free tier). OWNER_EMAIL = where YOU want to receive alerts.
#    Customers also get a booking-confirmation email from this same sender.
OWNER_EMAIL=
# 2) Instant phone push via Telegram (free): create a bot with @BotFather, then message it once
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email alerts for new contact-form messages (optional, via resend.com) ──
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ── Business & legal details (shown in footer, contact page and policy pages) ──
# NEXT_PUBLIC_* values are baked in at build time: change them, then REDEPLOY.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_HOURS=Mon–Sun: 7:00 AM – 9:00 PM
NEXT_PUBLIC_EMERGENCY_PHONE=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_FSSAI=
NEXT_PUBLIC_SERVICE_CITIES=
NEXT_PUBLIC_GRIEVANCE_NAME=
NEXT_PUBLIC_GRIEVANCE_DESIGNATION=Grievance Officer
NEXT_PUBLIC_GRIEVANCE_EMAIL=
NEXT_PUBLIC_GRIEVANCE_PHONE=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_YOUTUBE=
# Optional: real numbers for the homepage, as "value|label;value|label"
# NEXT_PUBLIC_STATS=
ALLOW_MOCK_PAYMENTS=false

# ── Phase 2 ──────────────────────────────────────────────────────────────────
# Online payments (Razorpay). Start with TEST keys (rzp_test_...). Leave empty to keep online payment switched off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Daily booking reminders: any long random string. Vercel sends it automatically to /api/cron/reminders.
CRON_SECRET=
# Bookings allowed per time slot (all services together). Default 3.
BOOKING_SLOT_CAPACITY=3
# Shop delivery rules (baked in at build time → redeploy after changing)
# Pincode prefixes you deliver to, e.g. "700,711,743". Empty = deliver everywhere.
NEXT_PUBLIC_SERVICEABLE_PINCODES=
# Largest order total allowed with Cash on Delivery (₹). Default 5000.
NEXT_PUBLIC_COD_MAX=5000
